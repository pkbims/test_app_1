# Non-secret configuration for `docker compose`. Committed on purpose so a clean
# checkout runs with `docker compose up` and nothing else. Secrets (OPENAI_API_KEY)
# live in .env, which is gitignored and loaded *after* this file so it wins.
DATABASE_URL=postgresql://app1:app1@db:5432/app1
PHOTO_DIR=/data/photos
APP_ENV=dev

# Dev-only signing secret. Overridden in staging/production via the real .env.
JWT_SECRET=dev-insecure-do-not-use-in-production

# Apple Sign In audience (the app's bundle id). Empty in dev; the auth route
# falls back to a test verifier when this is unset (see app/auth).
APPLE_CLIENT_ID=

# Vision backend: "fake" so `docker compose up` works with no OpenAI key. Set to
# "openai" in .env (with OPENAI_API_KEY) to run the real gpt-4.1 / gpt-image-2.
VISION_BACKEND=fake

# Public origin the client reaches the API on — goes into signed photo/render URLs.
PUBLIC_BASE_URL=http://localhost:8000

# Health thresholds (PRD §17).
QUEUE_DEPTH_DEGRADED=100
WORKER_HEARTBEAT_TIMEOUT_S=60

# Committed defaults for generate-project.sh — mirrors the repo's compose.env/.env
# layering (../compose.env + ../.env). Override locally in ios/.env (gitignored,
# real Team id), never here.

# Apple Developer Team id (Xcode > Settings > Accounts, or the Signing &
# Capabilities tab once a team is selected). Empty here means automatic signing
# with no team — fine for the Simulator, but Sign in with Apple's capability needs
# a real (paid) team either way; see ../ORCH-QUESTIONS.md Q5.
DESIGNMYROOM_DEV_TEAM=
